/* src/styles/restaurant.css */

.restaurant-container {
    padding: 40px 5%;
    max-width: 1000px;
    margin: 0 auto;
}

.kitchen-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--terracotta);
    padding-bottom: 15px;
    margin-bottom: 30px;
}

.order-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
}

.kitchen-card {
    background: rgba(255, 127, 17, 0.08);
    border: 1px solid rgba(255, 127, 17, 0.3);
    box-shadow: 0 20px 40px rgba(255, 127, 17, 0.08);
}

.kitchen-info-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
}

.kitchen-tag {
    padding: 10px 16px;
    border-radius: 18px;
    background: rgba(255, 127, 17, 0.14);
    color: var(--secondary);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
}

.item-total {
    margin-top: 18px;
    color: var(--text);
    font-weight: 800;
}

.kitchen-assigned-block {
    margin-top: 16px;
    display: grid;
    gap: 16px;
}

.order-items-list {
    list-style: none;
    padding: 0;
    margin: 15px 0;
    color: var(--text);
    font-size: 0.9rem;
}

.cooking-status {
    background: var(--primary);
    color: var(--white);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: bold;
}

.full-width-btn {
    width: 100%;
    margin-top: 15px;
}
.btn-panic {
    background: rgba(230, 57, 70, 0.12);
    color: var(--primary);
    border: 1px solid var(--primary);
    padding: 8px 15px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: 0.3s;
}

.btn-panic:hover {
    background: var(--primary);
    color: var(--white);
}

.history-section {
    margin-top: 60px;
    border-top: 1px solid rgba(45, 45, 45, 0.08);
    padding-top: 30px;
}

.history-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 25px !important;
}

.history-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.history-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(45, 45, 45, 0.6);
    font-size: 0.85rem;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.status-pill.success {
    background: rgba(46, 204, 113, 0.12);
    color: #27ae60;
}

.status-pill.danger {
    background: rgba(230, 57, 70, 0.12);
    color: var(--primary);
}

.text-success { color: #2d9c35; font-weight: bold; }
.text-danger { color: var(--primary); font-weight: bold; }

.active-border { border-left: 5px solid var(--secondary); }
.cooking-border { border-left: 5px solid var(--secondary); }
.ready-border { border-left: 5px solid rgba(45, 45, 45, 0.12); }@media (max-width: 900px) {
  .restaurant-container {
    padding: 30px 5%;
  }

  .kitchen-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .order-grid {
    grid-template-columns: 1fr;
  }

  .history-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
}

@media (max-width: 640px) {
  .restaurant-container {
    padding: 20px 4%;
  }

  .history-item {
    padding: 14px 18px !important;
  }
}

/* Advanced Kitchen Display System (KDS) Styles */
.kitchen-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 15px;
    margin-bottom: 25px;
}

.kitchen-stat-card {
    background: var(--surface-strong);
    border: 1px solid var(--border);
    padding: 15px 20px;
    border-radius: 18px;
    box-shadow: 0 4px 12px var(--shadow);
    text-align: left;
}

.kitchen-stat-card h5 {
    margin: 0 0 6px 0;
    color: var(--text);
    opacity: 0.6;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.kitchen-stat-card p {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--primary);
}

.checklist-title {
    margin-top: 15px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
}

.kitchen-items-checklist {
    margin: 10px 0;
}

.kitchen-item-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--border);
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s;
    color: var(--text);
}

.kitchen-item-row.checked {
    opacity: 0.4;
    text-decoration: line-through;
}

.kitchen-item-row input[type="checkbox"] {
    accent-color: var(--primary);
    width: 16px;
    height: 16px;
    cursor: pointer;
}

.prep-time-selector {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 15px;
}

.prep-time-options {
    display: flex;
    gap: 8px;
}

.btn-prep-option {
    flex: 1;
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-strong);
    color: var(--text);
    font-weight: bold;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-prep-option:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.kitchen-timer-block {
    margin-top: 18px;
    background: rgba(45, 45, 45, 0.02);
    padding: 14px;
    border-radius: 14px;
    border: 1px solid var(--border);
}

.timer-header-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
}

.timer-val {
    color: var(--secondary);
    font-size: 0.95rem;
    font-family: monospace;
}

.timer-val.overdue {
    color: var(--primary);
    animation: flash-red 1s infinite alternate;
}

.progress-bar-bg {
    height: 6px;
    background: rgba(45, 45, 45, 0.08);
    border-radius: 99px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    background: var(--secondary);
    border-radius: 99px;
    transition: width 1s linear, background-color 0.3s;
}

.progress-bar-fill.overdue {
    background: var(--primary);
}

@keyframes flash-red {
    from { opacity: 1; }
    to { opacity: 0.4; }
}

.kitchen-notes {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(230, 57, 70, 0.04);
    border-left: 3px solid var(--primary);
    font-size: 0.78rem;
    color: var(--text);
}

.kitchen-notes strong {
    color: var(--primary);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
}

.kitchen-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
}

.kitchen-tab-btn {
    padding: 8px 16px;
    border-radius: 10px;
    border: none;
    background: transparent;
    color: var(--text);
    opacity: 0.6;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.2s;
}

.kitchen-tab-btn.active {
    background: var(--surface-strong);
    color: var(--primary);
    opacity: 1;
    box-shadow: 0 4px 10px var(--shadow);
}

.kitchen-card .cuisine-text {
    color: var(--text) !important;
    opacity: 0.85 !important;
    font-size: 0.85rem;
    margin: 4px 0 0 0;
}

