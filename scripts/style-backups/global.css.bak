/* src/styles/global.css */
:root {
  --color-cream: #FFF8F0;
  --color-charcoal: #2D2D2D;
  --color-crimson: #E63946;
  --color-orange: #FF7F11;

  --bg: #ffffff;
  --primary: var(--color-crimson);
  --secondary: var(--color-orange);
  --text: var(--color-charcoal);
  --surface: rgba(255, 248, 240, 0.85);
  --surface-soft: rgba(255, 248, 240, 0.65);
  --surface-strong: #ffffff;
  --border: rgba(45, 45, 45, 0.08);
  --shadow: rgba(45, 45, 45, 0.06);
  --button-gradient: linear-gradient(135deg, var(--color-crimson), var(--color-orange));
  --glow: rgba(230, 57, 70, 0.12);
  --white: #ffffff;
  --light-gray: rgba(45, 45, 45, 0.06);
  --glass: rgba(255, 255, 255, 0.6);

  --cream: var(--color-cream);
  --terracotta: var(--color-crimson);
  --orange: var(--color-orange);
  --mustard: var(--color-orange);
  --dark-forest: var(--color-charcoal);
  --dark-green: var(--color-charcoal);
  --madras: var(--color-crimson);
  --pumpkin-squash: var(--color-orange);
  --buzzworthy: var(--color-orange);
  --sangria-red: var(--color-crimson);
  --carrageen-moss: var(--color-charcoal);
  --black-mesa: rgba(45, 45, 45, 0.06);
}

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin: 0;
  min-height: 100vh;
  transition: all 0.5s ease;
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0;
}

/* Futuristic Glassmorphism */
.glass-card {
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(45, 45, 45, 0.08);
  border-radius: 24px;
  padding: 30px;
  box-shadow: 0 20px 40px rgba(45, 45, 45, 0.08);
  position: relative;
  overflow: hidden;
}

/* Glowing Pulse Animation for Active Status */
@keyframes pulse-glow {
  0% { box-shadow: 0 0 0 0 rgba(214, 205, 131, 0.4); }
  70% { box-shadow: 0 0 0 15px rgba(214, 205, 131, 0); }
  100% { box-shadow: 0 0 0 0 rgba(214, 205, 131, 0); }
}

.active-glow {
  animation: pulse-glow 2s infinite;
  border: 2px solid var(--orange) !important;
}

/* Premium Glass Utility */
.premium-glass {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(45, 45, 45, 0.08);
  box-shadow: 0 22px 48px rgba(45, 45, 45, 0.08);
}

/* Premium Buttons */
.btn-premium {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--button-gradient);
  color: var(--white);
  border: none;
  padding: 14px 32px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8px 22px rgba(230, 57, 70, 0.24);
}

.btn-premium:hover {
  transform: scale(1.05) translateY(-2px);
  box-shadow: 0 8px 25px var(--glow);
  filter: brightness(1.2);
}

.btn-premium:disabled,
button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  filter: none;
  transform: none;
}

.full-width-btn {
  width: 100%;
}

/* Toast Notification Styles */
.toast-container {
    position: fixed;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    animation: slideDown 0.5s ease-out;
}

.toast-content {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--primary);
    color: var(--white);
    padding: 12px 25px;
    border-radius: 12px;
    box-shadow: 0 15px 35px rgba(45, 45, 45, 0.12);
    border: 1px solid rgba(230, 57, 70, 0.2);
}

.toast-icon {
    display: flex;
    align-items: center;
    color: var(--dark-green);
}

@keyframes slideDown {
    from { transform: translate(-50%, -100%); opacity: 0; }
    to { transform: translate(-50%, 0); opacity: 1; }
}

.input-field {
    border: none;
    padding: 12px 20px;
    outline: none;
    font-size: 1rem;
    width: 100%;
    border-radius: 10px;
}

.social-links-container {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.social-brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.social-text-group {
    display: flex;
    gap: 20px;
}

.footer-nav-link {
    color: var(--dark-forest);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s ease;
    opacity: 0.6;
    position: relative;
}

.footer-nav-link:hover {
    opacity: 1;
    color: var(--primary);
    transform: translateY(-2px);
}

/* Adds a small underline on hover */
.footer-nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--terracotta);
    transition: width 0.3s ease;
}

.footer-nav-link:hover::after {
    width: 100%;
}

/* Footer layout and styles */
.premium-footer {
  margin-top: 60px;
  padding: 50px 8%;
  background: var(--surface);
  color: var(--text);
  border-top: 1px solid rgba(45, 45, 45, 0.08);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 30px;
  align-items: start;
}

.footer-about {
  max-width: 420px;
}

.footer-logo {
  margin: 0 0 10px 0;
  color: var(--primary);
  font-size: 1.6rem;
  letter-spacing: 1px;
}

.footer-links h4,
.footer-contact h4 {
  color: var(--primary);
  margin-bottom: 12px;
}

.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
  color: var(--text);
  opacity: 0.85;
}

.footer-contact p {
  margin: 6px 0;
  opacity: 0.9;
}

.social-icons {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.social-text-link {
  color: var(--cream);
  text-decoration: none;
  opacity: 0.85;
}

.social-divider {
  opacity: 0.35;
}

.footer-bottom {
  margin-top: 30px;
  text-align: center;
  color: var(--text);
  opacity: 0.6;
  font-size: 0.95rem;
}

@media (max-width: 900px) {
  .footer-grid { grid-template-columns: 1fr; }
  .hero-section { padding: 80px 6%; }
}

@media (max-width: 700px) {
  .glass-card {
    padding: 24px;
    border-radius: 20px;
  }

  .btn-premium {
    padding: 12px 24px;
    font-size: 0.95rem;
  }

  .toast-container {
    top: 80px;
    left: 10%;
    transform: none;
    width: auto;
    right: 10%;
  }

  .input-field {
    width: 100%;
  }
}

.app-loading,
.error-boundary-shell,
.notfound-page,
.unauthorized-page {
  min-height: calc(100vh - 120px);
  display: grid;
  place-items: center;
  padding: 40px 20px;
}

.error-fallback,
.notfound-card,
.unauthorized-card {
  max-width: 520px;
  width: 100%;
  padding: 32px;
  border-radius: 28px;
  border: 1px solid rgba(45, 45, 45, 0.08);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 20px 60px rgba(45, 45, 45, 0.08);
  text-align: center;
}

.error-fallback h1,
.notfound-card h1,
.unauthorized-card h1 {
  margin-bottom: 16px;
  color: var(--primary);
}

.unauthorized-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 22px;
}

